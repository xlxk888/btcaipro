{
  "name": "crypto-ai-market-infrastructure",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "worker": "node --env-file-if-exists=.env src/worker-runner.js",
    "discovery:health": "node --env-file-if-exists=.env src/discovery/healthcheck.js",
    "test": "node --test",
    "check": "node --check src/server.js && node --check src/worker-runner.js"
  },
  "dependencies": {
    "@vercel/functions": "^3.9.8",
    "pg": "^8.16.3"
  }
}
