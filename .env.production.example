# Copy to a private .env on the Compose host. Set a real externally reachable PostgreSQL URL.
# Worker and Vercel must use the same PostgreSQL database; credentials may use separate roles.
DATABASE_URL=
DISCOVERY_ENABLED=true
DISCOVERY_CHAINS=robinhood,ethereum,bsc,arbitrum,base,polygon,avalanche,solana
DISCOVERY_RPC_URLS_ROBINHOOD=
DISCOVERY_RPC_URLS_ETHEREUM=
DISCOVERY_RPC_URLS_BSC=
DISCOVERY_RPC_URLS_ARBITRUM=
DISCOVERY_RPC_URLS_BASE=
DISCOVERY_RPC_URLS_POLYGON=
DISCOVERY_RPC_URLS_AVALANCHE=
DISCOVERY_RPC_URLS_SOLANA=
MONERO_RPC_URLS=
WORKER_ENABLED=false
MARKET_SYMBOLS=BTCUSDT,ETHUSDT
LOG_LEVEL=info
